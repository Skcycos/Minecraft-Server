"distanthorizons.config.client.advanced.graphics.culling.caveCullingHeight": "洞穴裁剪高度",
"distanthorizons.config.client.advanced.graphics.culling.caveCullingHeight.@tooltip": "洞穴裁剪开始应用的高度。",
"distanthorizons.config.client.advanced.graphics.culling.disableBeaconDistanceCulling": "禁用信标距离裁剪",
