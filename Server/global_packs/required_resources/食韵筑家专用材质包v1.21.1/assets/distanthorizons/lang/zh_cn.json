"distanthorizons.config.client.advanced.graphics.texture": "纹理",
"distanthorizons.config.client.advanced.graphics.texture.enableTexturedLods": "启用纹理 LOD",
"distanthorizons.config.client.advanced.graphics.texture.enableTexturedLods.@tooltip": "如果启用，LOD 将使用方块纹理进行渲染。\n\n§6注意：§r 启用此设置将大幅增加内存和 GPU 使用。",
"distanthorizons.config.client.advanced.graphics.texture.maxTexturedLodDetailLevel": "最大纹理 LOD 细节级别",
