"distanthorizons.config.client.advanced.graphics.noiseTexture.enableNoiseTexture": "启用噪声纹理",
"distanthorizons.config.client.advanced.graphics.noiseTexture.enableNoiseTexture.@tooltip": "如果启用，LOD 将使用噪声纹理来模拟细节。",
"distanthorizons.config.client.advanced.graphics.noiseTexture.noiseSteps": "噪声步数",
"distanthorizons.config.client.advanced.graphics.noiseTexture.noiseSteps.@tooltip": "噪声纹理的步数。\n\n较高的值会增加细节，但也会增加内存和 GPU 使用。",
"distanthorizons.config.client.advanced.graphics.noiseTexture.noiseIntensity": "噪声强度",
