  "displayFilter": {
    "mode": "byTarget",
    "hideSelfDamage": true,
    "bySource": {
      "player": {
        "sameTeam": false,
        "otherTeam": false
      },
      "mob": {
        "hostile": false,
        "passive": false
      },
      "other": false
    },
    "byTarget": {
      "player": {
        "sameTeam": true,
        "otherTeam": true
      },
      "mob": {
        "hostile": true,
        "passive": true
      },
      "other": true
    }
  },
  "minDamageDisplay": 0.1,
  "maxActiveNumbers": 999,
  "showHealing": true,
  "showAbsorption": true,
  "distanceScale": {
    "segment": 10.0,
    "factor": 0.2,
    "min": 0.3,
    "maxDisplayDistance": 64.0
  },
  "maxDisplayDistance": 64.0,
  "totalDamage": {
    "enabled": false,
    "resetTimeout": 100,
    "maxTrailCount": 20,
    "baseFontSize": 2.0,
    "sizeOffsetPerThousand": 0.5,
    "sizeOffsetMax": 3.0,
    "selectors": {
      "common": {
        "style": "default"
      }
    },
    "positionX": -0.15,
    "positionY": 0.15,
    "enableEntryAnimation": true,
    "enableExitAnimation": true,
    "enableBounceAnimation": true,
    "enableTrailEntryAnimation": true,
    "enableTrailExitAnimation": true,
    "bounceScalePeak": 1.4,
    "labelText": "Damage"
  },
  "displayOpacity": {
    "player": 1.0,
    "mobHostile": 0.5,
    "mobPassive": 0.75,
    "other": 1.0
  },
  "killOnlyOnMobDeath": false,
  "killOnlyFullHealth": false,
  "hideFullHealthHeal": true,
  "displayScope": "all",
  "hideBehindWall": false,
  "numberAbbreviation": {
    "enabled": false,
    "threshold": 1000.0,
    "suffixes": [
      "k",
      "M",
      "B",
      "T"
    ],
    "decimalPlaces": 1
  }
}