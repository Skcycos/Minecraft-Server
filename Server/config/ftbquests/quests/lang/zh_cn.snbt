{
	chapter.311AF39983F605B3.title: "刀剑"
	chapter.453978995B91E7B3.title: "灵魂锻造&r-未完成 "
	chapter.70EDDE3627900FA8.title: "欢迎来烟火筑家"
	quest.01796B0AEC8DD0F2.quest_desc: ["&d「灵魂石是这条路的第一块砖。去找到它，别把矿洞里所有紫色的东西都叫成紫水晶，小迷糊。」&r"]
	quest.01796B0AEC8DD0F2.quest_subtitle: "&7精魂魔法的基石"
	quest.01796B0AEC8DD0F2.title: "&e取出粗灵魂石&r"
	quest.051DFB605A0D3F2B.quest_desc: [
		"&d「先把奥术全典翻开。别急着把它当成装饰品——灵灾的门，从读懂第一行文字开始。」&r"
		""
		"这是灵灾的入门任务。让玩家先阅读模组指南，了解精魂、灵魂石与后续设备。"
	]
	quest.051DFB605A0D3F2B.quest_subtitle: "&7先读书，再碰那些会发光的灵魂"
	quest.051DFB605A0D3F2B.title: "&e1. 翻开奥术全典&r"
	quest.0674428CEA000BA8.quest_subtitle: "&7会进攻的人很多，会停刀的人更少"
	quest.0674428CEA000BA8.title: "&e掌握防御与格挡"
	quest.06C8FB2F8C638C23.quest_desc: ["&d「把它拿在手里看看。现在它只是一把无铭之刃，杀敌数、耀魂和精炼都还没有写下第一笔。别急着嫌它普通，普通正是成长的起点。」&r"]
	quest.06C8FB2F8C638C23.quest_subtitle: " &7无垢之器，等待第一个名字"
	quest.06C8FB2F8C638C23.title: "&e无铭「无名」"
	quest.086CF68B8FE61954.quest_desc: [
		"&d「去皮橡木的纹理很适合做家具。先弄一块回来吧——别站在树下研究半天，树不会自己走进你的背包。」&r"
		""
		"&f这是烟火筑家的第一步：收集材料，给自己准备一个可以落脚的地方。"
	]
	quest.086CF68B8FE61954.quest_subtitle: "&7木屋的第一根柴火"
	quest.086CF68B8FE61954.title: "&e找到第一棵树"
	quest.0D2944F4EC5E1CD3.quest_desc: ["&d「现在才轮到真正的收割。拿好镰刀，去找那些轻盈、敏捷、喜欢飞来飞去的家伙。鸡也算，别小看它们的灵魂。」&r"]
	quest.0D2944F4EC5E1CD3.quest_subtitle: "&7让无形之物留下形状"
	quest.0D2944F4EC5E1CD3.title: "&e收割澄空精魂&r"
	quest.0F3A52C30AA7C776.quest_desc: [
		"&d「过来，别站在灶台边发呆。这里有一把刚刚替你准备好的刀，它还没有名字，也没有辉煌的战绩，但每一位真正的剑士，都是从一把无铭之刃开始的。」&r"
		""
		"&f这把刀是你的新手赠礼。它拥有耐久和经验修补附魔，但真正让它成长的，是你之后留下的战斗记录。"
	]
	quest.0F3A52C30AA7C776.quest_subtitle: "&7每一位剑士，都应该有一把自己的刀"
	quest.0F3A52C30AA7C776.title: "&5灶火中的刀光"
	quest.12D9C1DCF56F2BFD.quest_desc: ["&d「冒险结束后，把刀放到刀挂台上。它会比随手丢在箱子角落里体面得多，也更配得上你以后建的那间漂亮屋子。」&r"]
	quest.12D9C1DCF56F2BFD.quest_subtitle: "&7刀也需要一个体面的归处"
	quest.12D9C1DCF56F2BFD.title: "&e让刀在刀挂台上休息"
	quest.153FD12A0E1CBCE1.quest_desc: [
		"&d「我还记得你第一次从灶火边接过它的样子。那时它只是无铭之刃，现在它已经写满了你的战斗、你的失误，还有你一次次重新站起来的样子。」&r"
		""
		"&f拔刀剑的故事没有结束。继续精炼、学习剑技、寻找名刀，或者把它挂在自己的屋子里，让来访的朋友看看这段旅程。"
	]
	quest.153FD12A0E1CBCE1.quest_subtitle: " &7从新手赠礼，到真正的佩刀"
	quest.153FD12A0E1CBCE1.title: "&5你的刀，已经有名字了"
	quest.16A579014FC0FA1C.quest_desc: [
		"&d「认领一小块土地。别一下子把整片山都圈走，给后来的人留条路，也给自己的金币留点余地认领」"
		""
		"「'」键认领"
	]
	quest.16A579014FC0FA1C.quest_subtitle: "&7这是你的家，不是怪物的自助餐厅"
	quest.16A579014FC0FA1C.title: "&e给家园画一条边界"
	quest.1BAE5F9EBA04E5EC.quest_desc: ["&d「服务器里有 刀剑、法术、弓箭 和其他战斗内容。先做一把适合自己的武器，挥两下试试手感。对着空气练习没关系，对着村民练习就不太行了。」&r"]
	quest.1BAE5F9EBA04E5EC.quest_subtitle: "&7出门前，先确认剑在手边"
	quest.1BAE5F9EBA04E5EC.title: "&e准备第一把像样的武器"
	quest.1DF6BFA1C60A1667.quest_desc: [
		"&d「金币放着不会自动变成房子。挑一件你喜欢的建筑材料买下来，哪怕只是一个窗框——家是从第一块真正想放好的方块开始的。」&r"
		""
		"&a在建筑商店购买任意一件商品。"
	]
	quest.1DF6BFA1C60A1667.quest_subtitle: "&7让金币第一次离开钱包"
	quest.1DF6BFA1C60A1667.title: "&e买下第一块建材"
	quest.1E8F39426C167A75.quest_desc: [
		"&d「精魂坩埚准备好了。它会把奥术能量聚到材料上，速度不算快，但好东西通常不会急着赶路。」&r"
		"精魂坩埚是灵灾中后期材料处理与增强的核心设备。"
	]
	quest.1E8F39426C167A75.quest_subtitle: "&7让能量在坩埚里汇聚"
	quest.1E8F39426C167A75.title: "制作精魂坩埚&r"
	quest.20231AB64EC4BE71.quest_desc: ["&d「泰拉、无人之地和其他地形内容，已经把远方变得很有意思。带上食物和挎包，沿着地图走一段，别只在出生点附近绕圈。」&r"]
	quest.20231AB64EC4BE71.quest_subtitle: "&7世界比木屋门口大得多"
	quest.20231AB64EC4BE71.title: "&e走出熟悉的街巷"
	quest.202644A7C353356D.quest_desc: [
		"&a消耗耀魂成功使用一次幻影剑。"
		""
		"&d「当耀魂积攒到足够多时，可以召唤幻影剑。它们只停留一瞬，却足够让敌人明白：你已经不只是拿着一把漂亮的刀了。」&r"
	]
	quest.202644A7C353356D.quest_subtitle: "&7让耀魂化作第二道锋芒"
	quest.202644A7C353356D.title: "&e召唤幻影剑"
	quest.257A412DBC052D41.quest_desc: ["&d「给坩埚装上精魂催化器。它能加快过程，不过别一下子塞太多，过热的坩埚和炸掉的厨房一样让人心疼。」&r"]
	quest.257A412DBC052D41.quest_subtitle: " &7给漫长的锻造添一把火"
	quest.257A412DBC052D41.title: "安装精魂催化器&r"
	quest.260AAD18F8C8EC89.quest_desc: [
		"&d「你已经有住所、食物、工具，也知道怎么保护自己的东西了。接下来，可以选择一条更适合自己的路：种田、做菜，或者……走一条不那么光明正大的路。」&r"
		""
		"{quest_enhance_table:eNpFjjsKwkAQhu8y9QpZYkzMEbyChJCYMVnY7MJmfSEWloKlhdjYWNvYCLmO-LiF4yt2M98M__fPYahNmdh4jKYSWkHoMhhoOSpV9Z4LTDI0EFozQgaJFLkqUVkIQeLQAgObpBLjichsAaHDwOhJXKDIC_rhAQMpVHPmDFJtKC8mhabUVsfnThD4P0_Ducu9jsM9KoNS_nHbdz2n3SUtTu0fv7VUuN-H-3J9Oe9up_pW76neo97ej4frevXYHGntQRQxKNHk-HqPvvmVnckPWDwBMcVhXg}"
		"&f农夫、厨师和影窃者各有自己的任务线。选择之前想清楚一点，尤其是影窃者——没有选择对应职业，就不能使用职业专属的偷窃能力。"
	]
	quest.260AAD18F8C8EC89.quest_subtitle: " &7你想成为哪一种冒险者？"
	quest.260AAD18F8C8EC89.title: "&d认识职业系统"
	quest.2809791110485D6A.quest_desc: [
		"&d「任务书不是装饰品，小迷糊。遇到不知道该做什么的时候，先来这里看看；遇到知道该做什么但懒得看的时候……也先来这里看看。」&r"
		""
		"&f任务书会记录你的成长路线，也会告诉你服务器里哪些玩法值得尝试。"
	]
	quest.2809791110485D6A.quest_subtitle: "&7别让它一直躺在背包里吃灰"
	quest.2809791110485D6A.title: "&e把任务书翻开"
	quest.292D1B003610EB78.quest_desc: ["&d「传送石碑是给会探索、但方向感偶尔离家出走的人准备的。放心，我不会因为你绕了三圈才找到木屋而笑你……太大声而已。」r"]
	quest.292D1B003610EB78.quest_subtitle: " 迷路不可怕，死活找不到家才可怕"
	quest.292D1B003610EB78.title: "&e留下一个回家的路标"
	quest.2B71EFD9AFD15092.quest_desc: [
		"&a完成一次剑技练习，建议从“次元斩”或基础连击开始。"
		""
		"&d「拔刀剑有自己的剑技。先从最容易掌握的招式开始，学会蓄力、出招和收刀。剑技很帅，但先确认前面没有自己的墙。」&r"
	]
	quest.2B71EFD9AFD15092.quest_subtitle: "&7真正的刀，不只会普通攻击"
	quest.2B71EFD9AFD15092.title: "&e学习一次剑技"
	quest.2D407AD33889A9E7.quest_desc: ["&d「看到结构里的箱子时，先看看周围有没有危险。现在战利品更公平，但它可不会替你挡住身后的怪物。」&r"]
	quest.2D407AD33889A9E7.quest_subtitle: " &7箱子里可能有惊喜，也可能只有一双旧靴子"
	quest.2D407AD33889A9E7.title: "&e打开一份战利品"
	quest.312260C6E3ECF292.quest_desc: ["&d「这是随身挎包，适合装食物、工具和那些‘以后一定有用’的材料。至于你捡到的第十七块泥土……嗯，也可以先放进去。」&r"]
	quest.312260C6E3ECF292.quest_subtitle: " &7冒险者不该把东西全塞在口袋里"
	quest.312260C6E3ECF292.title: "&e背上你的随身挎包"
	quest.319927115232E9AE.quest_desc: ["&d「找一只普通敌对生物练练手。记得观察攻击距离和节奏，好的架势可不是让你拿着剑乱挥的理由。」&r"]
	quest.319927115232E9AE.quest_subtitle: "&7夜晚不是用来站在门口发呆的"
	quest.319927115232E9AE.title: "&e击败第一只怪物"
	quest.330B442C6A97131B.quest_desc: ["&d「悬赏板上总有一些小委托。收集、击杀、探索，各有各的报酬。先完成一份简单的，回来时我给你留一碗热汤。」&r"]
	quest.34721432D5A2D820.quest_desc: ["&d「把木板摆好，工作台就会出现。很神奇，对吧？虽然我更喜欢把它叫作‘以后会堆满东西的第一张桌子’。」&r"]
	quest.34721432D5A2D820.quest_subtitle: "&7所有木屋都从这里开始"
	quest.34721432D5A2D820.title: "&e制作工作台"
	quest.352475C935326FA2.quest_desc: [
		"使用"
		"atm来存入你的铜币，这样才能购买一些物品和进入股市"
	]
	quest.352475C935326FA2.quest_subtitle: "需要补充"
	quest.352475C935326FA2.title: "&e小心别丢了"
	quest.357F43B0252B02D1.quest_desc: [
		"&d「把精魂祭坛搭起来。灶台能把食材变成热饭，祭坛则会把材料和灵魂编成另一种答案——原理不同，摆放时同样别手滑。」&r"
		""
		"符文基座是可以在祭坛周围的四格内都有效，每个基座都相当于一个合成的格子，后期你可能需要很多这样的“格子”"
	]
	quest.364A8B9152328521.quest_desc: [
		"&d「有了镰刀，才有资格锻造魂染钢。去收集邪术、大地和奥术精魂，再把铁锭送进精魂祭坛。」&r"
		"魂染钢锭需要精魂祭坛、铁锭、精制灵魂石，以及邪术、大地和奥术精魂。可分别通过僵尸、牛和骷髅等生物收割补齐材料。"
	]
	quest.364A8B9152328521.quest_subtitle: "&7金属也会记住灵魂的温度"
	quest.364A8B9152328521.title: "锻造魂染钢锭&r"
	quest.36CCC7B475AA0F27.quest_desc: ["想必你现在已经有点受够了这磨磨叽叽的精魄祭坛的合成速度，现在你可以制作方尖碑来加快他们的合成速度，一个祭坛周围最多只能有四个"]
	quest.36CCC7B475AA0F27.title: "加速加速"
	quest.3E9F3C6525A56C51.quest_desc: [
		"&d「木屋的门没有锁，灶台上的火也还亮着。欢迎来到烟火筑家，我是住在这里的虚拟小管家。先把任务书翻开，认认路，再去折腾那些会爆炸的东西。」&r"
		""
		"&f这里不要求你立刻变成冒险家。先了解服务器的基本规则、经济和任务系统，之后的路会轻松很多。"
	]
	quest.3E9F3C6525A56C51.quest_subtitle: " &7先别急着往矿洞里跳"
	quest.3E9F3C6525A56C51.title: "&6灶火边的来客"
	quest.3F9229666202F576.quest_desc: ["&d「木镐、木斧、木剑，先做齐。拿着一块原木冲去和骷髅讲道理，可不算勇敢，只能算有点莽。」&r"]
	quest.3F9229666202F576.quest_subtitle: "&7别用手和石头较劲"
	quest.3F9229666202F576.title: "&e做一套趁手的工具"
	quest.40FB8882972BCC9F.quest_desc: ["&d「拿着调谐音叉听一听坩埚的回响。机器不会说话，但它会用声音告诉你哪里还可以变得更好。」&r"]
	quest.40FB8882972BCC9F.quest_subtitle: "&7听见奥术结构的回声"
	quest.40FB8882972BCC9F.title: "调谐坩埚回响&r"
	quest.44554028E53D9323.quest_desc: ["&d「木材放木材，食物放食物，别把种子和剑丢在同一个角落里。等你以后拥有一整面仓库时，会感谢现在愿意整理的自己。」&r"]
	quest.44554028E53D9323.quest_subtitle: "&7箱子会记得你放过什么吗？不会，所以要整理"
	quest.44554028E53D9323.title: "&e给物资找个家"
	quest.4A939B1F03A1EFE7.quest_desc: ["&d「把粗灵魂石送进熔炉。灵魂石要先经过火焰，才承受得住后面的奥术结构。」&r"]
	quest.4A939B1F03A1EFE7.quest_subtitle: "&7把粗粝的灵魂打磨成光"
	quest.4A939B1F03A1EFE7.title: "&e炼制精制灵魂石&r"
	quest.516BC0844876A38F.quest_desc: ["&d「火把不只是照明，也是‘这里有人住，不要随便刷怪’的温柔提醒。多放几根，晚上回家时心情会好很多。」&r"]
	quest.516BC0844876A38F.quest_subtitle: " &7黑暗里会有东西盯着你的箱子"
	quest.516BC0844876A38F.title: "&e给住所点上灯"
	quest.51CA3E6746D59D27.quest_desc: ["&d「耀魂碎片可以继续提炼。破碎的灵魂、耀魂铁锭、耀魂宝珠和耀魂结晶，每一步都代表更高的强化潜力。」&r"]
	quest.51CA3E6746D59D27.quest_subtitle: " &7耀魂会从碎片变成更坚韧的形状"
	quest.51CA3E6746D59D27.title: "&e锻造灵魂材料"
	quest.54B4D7A9468166D8.quest_desc: [
		"如果你找不到树苗。可以去商店中买一个，然后等待他张成大树。"
		"你会在树干上看到一个特别的方块，闪闪发光，使用斧头剥皮，然后就可以用玻璃瓶取下了"
		""
		"你可以将他的原木烧制成蕴含魔法的木炭，它会比普通的更加耐烧"
	]
	quest.54F4F0B4F7374596.quest_desc: ["&d「拔刀不是乱挥。锁定目标，找准距离，在该出手的时候让刀出鞘。很好——至少这次没有砍到自己的门。」&r"]
	quest.54F4F0B4F7374596.quest_subtitle: "&7刀刃出鞘之前，先找好目标"
	quest.54F4F0B4F7374596.title: "&e第一次出鞘"
	quest.5AA0877896706069.quest_desc: [
		"&d「把粗制镰刀升级成魂染钢镰刀。它会让收割变得更有效率；别只顾着挥得开心，记得留意镰刀上的灵魂回响。」&r"
		""
		"升级需要粗制镰刀、魂染钢锭、精制灵魂石、邪灰，以及对应的精魂储备。"
	]
	quest.5AA0877896706069.quest_subtitle: "&7让武器真正开始工作"
	quest.5AA2B118B423DC54.quest_desc: [
		"&d「我当然记得每一道菜的配方，但我不打算替你把所有东西都塞进手里。打开 JEI 或物品查询，自己看一眼，之后做饭和做机器都会省事。」"
		"&r"
		""
		"&f服务器安装了 JEI、物品查询和配方辅助模组。学会查配方，比盲目试错可靠得多。"
		"{@pagebreak}"
		"&6灶台边的小狐狸&f把围裙上的炭灰拍了拍，狐耳轻轻一抖，尾巴在身后慢慢摇了两下。"
		"&e结论先说：&f想快速找物品、看配方、管背包，直接用JEI。"
		"现在加了拼音搜索，打拼音或首字母就能搜到中文物品名，不用再一个个翻了。"
		"&a【怎么用】"
		"&b1. 打开JEI按E打开背包，右边那一长条就是物品列表，底部有搜索框。"
		"&d2. 搜索直接打中文名，或者用拼音（全拼、首字母都行）。比如钻石可以搜 &ezuanshi&f 或 &ezs&f，铁锭可以搜 &etieding&f 或 &etd&f。"
		"&c3. 看配方和用途鼠标悬停在物品上：按 &lR&r 看怎么合成按&lU&r看能用来做什么"
		"{@pagebreak}"
		"&6小狐狸Tips：&f常用物品可以收藏进书签，下次直接点出来。别像小迷糊一样满世界翻箱子，JEI比你记性好。有离谱操作我会轻轻吐槽，但不会真生气。有问题直接问，我在灶台边等着。"
	]
	quest.5AA2B118B423DC54.quest_subtitle: "&7不会做没关系，先学会查"
	quest.5AA2B118B423DC54.title: "&e认出配方的路"
	quest.5BC5A882D8B7FC36.quest_desc: [
		"&6灶台边的小狐狸&f把一本厚重的书从火炉旁推了过来，狐耳轻轻一抖。"
		""
		"&d「这次要接触的不是普通的火焰和铁。灵灾研究的是精魂、灵魂石，以及那些愿意用代价换取力量的仪式。」&r"
		""
		"&f她把围裙上的灰拍掉，尾巴绕到身后：&e「先读懂，再动手。尤其是誓令，签下去之前可要看清楚——我不负责替小迷糊反悔。」"
	]
	quest.5BC5A882D8B7FC36.title: "&6故事开场&r"
	quest.5C131B108BCD8098.quest_desc: [
		"&d「床放好之后，记得亲自躺一下。只放不睡可不算入住，难道你打算站在门口过夜吗？」&r"
		"&a放置并使用床，设置个人出生点。"
	]
	quest.5C131B108BCD8098.quest_subtitle: " &7白天挖矿，晚上好好睡觉"
	quest.5C131B108BCD8098.title: "&e安置床铺"
	quest.6087D8DAA9AC5E3B.title: "获取第一桶金"
	quest.62DB860BE4003199.quest_desc: ["&d「我喜欢看种子破土，也喜欢看厨房里堆满刚摘下来的食材。先种下一批作物吧，别把种子全拿去投掷，农田可不会自己长出来。」&r"]
	quest.62DB860BE4003199.quest_subtitle: "&7灶台旁边，应该有一片绿油油的田"
	quest.62DB860BE4003199.title: "&e开垦第一块农田"
	quest.64F988C954EBE12F.quest_desc: ["&d「食物做好啦。别急着拿去卖，先自己吃一口。认真生活的人，值得吃到热乎乎的饭——这是我这只小狐狸的厨房规矩。」&r"]
	quest.64F988C954EBE12F.quest_subtitle: "&7给忙了一圈的自己一点奖励"
	quest.64F988C954EBE12F.title: "&e端出第一道菜"
	quest.65B86186A72997DD.quest_desc: ["&d「阎魔刀、散华、夜叉、鄂门、村正，还有狐月刀。它们不是新手随手拿来挥两下的玩具。等你准备好，再去追寻属于自己的名刀。」&r"]
	quest.65B86186A72997DD.quest_subtitle: " &7刀名会被记住，持刀的人也一样"
	quest.65B86186A72997DD.title: "&e见证一把名刀"
	quest.67D7EB63373105B1.quest_desc: ["&d「我喜欢漂亮的屋檐、整齐的街道和亮着灯的小窗户。建筑商店里有不少能帮你布置家园的材料，先打开看看，别只盯着泥土发呆。」&r"]
	quest.67D7EB63373105B1.quest_subtitle: "&7漂亮的房子需要一点材料，也需要一点规划"
	quest.67D7EB63373105B1.title: "&e认识建筑商店"
	quest.6AAFBB0676B58836.quest_desc: ["&d「把准星放到刀上，看看它的说明。杀敌数是你的足迹，耀魂是刀的潜能，精炼则是一次次锤炼留下的回声。看懂它，你才算真正拿起它。」&r"]
	quest.6AAFBB0676B58836.quest_subtitle: "&7杀敌数、耀魂、精炼：刀会记住一切"
	quest.6AAFBB0676B58836.title: "&e读懂刀身上的记录"
	quest.6DAD7ADCC2DB1FF2.quest_desc: ["&d「看，刀刃附近留下了紫色的灵魂之火。那是耀魂碎片，是拔刀剑继续成长的材料。收好它，别和泥土一起丢进岩浆。」&r"]
	quest.6DAD7ADCC2DB1FF2.quest_subtitle: "&7战斗留下的，不只有掉落物"
	quest.6DAD7ADCC2DB1FF2.title: "&e收下第一枚耀魂"
	quest.6EF1F919C26CE734.quest_desc: ["&d「无铭『无名』会陪你走一段路，但总有一天，你会想看看白鞘、竹光、银纸竹光，甚至那些真正有故事的名刀。」&r"]
	quest.6EF1F919C26CE734.quest_subtitle: " &7无铭只是开始，不是终点"
	quest.6EF1F919C26CE734.title: "&e寻找更好的刀身"
	quest.70F7FFCAA6D36E14.quest_desc: ["&d「试着连续攻击几次，感受刀势的节奏。不要一看到怪物就把所有按键一起按下去，小狐狸的尾巴都快被你吓得炸开了。」&r"]
	quest.70F7FFCAA6D36E14.quest_subtitle: "&7一刀是攻击，连续的刀才是剑技"
	quest.70F7FFCAA6D36E14.title: "&e连击入门"
	quest.723800854425377C.quest_desc: ["&d「先从粗制镰刀开始。它不够华丽，但收割精魂这件事，可靠比漂亮重要——当然，能又可靠又漂亮就更好了。」&r"]
	quest.723800854425377C.quest_subtitle: "&7第一把收割灵魂的镰刀"
	quest.723800854425377C.title: "&e制作粗制镰刀&r"
	quest.73B11BA517CCA724.quest_desc: ["&d「把刀放上铁砧，试着进行一次精炼。精炼需要经验，也需要耀魂。别把最后一点经验全花光，回家修刀时还会用到它。」&r"]
	quest.73B11BA517CCA724.quest_subtitle: " &7千锤百炼之后，刀才会回应你"
	quest.73B11BA517CCA724.title: "&e尝试精炼"
	quest.7B4A5158B56C394E.quest_desc: ["&d「切菜板摆好，厨刀拿稳。厨房里最重要的不是动作快，而是别把食材切到地上——那样我会有一点点心疼。」&r"]
	quest.7B4A5158B56C394E.quest_subtitle: " &7料理不是把食材扔进锅里就结束"
	quest.7B4A5158B56C394E.title: "&e准备一块切菜板"
	task.2047826561E1C0DA.title: "&a阅读职业说明，并选择一个职业"
	task.23FB5415F062CC14.title: "1"
	task.357462FF3B3E61DF.title: "1"
	task.40DDC82D7309B7C5.title: "&e给家园画一条边界"
	task.45B81A3E1683490B.title: "欢迎来到烟火筑家"
	task.699619A327E3A8D0.title: "&5你的刀，已经有名字了"
}
