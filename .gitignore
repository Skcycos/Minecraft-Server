Server/automodpack/host-modpack/automodpack-content.json

# 测试运行产物（accept/smoke 验收脚本输出与 PID）
Server/accept*.out
Server/accept*.pid
Server/smoke*.out
Server/smoke*.pid

# 部署前备份目录
Server/backup-*/

# 本地开发 / 临时目录
/.gradle-home/
/tmp/
/mod develop/源码参考/

# 未启用的模组文件（禁用占位 / 副本）
