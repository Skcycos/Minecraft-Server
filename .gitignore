Server/mods/*副本*.jar

# 配方表生成中间产物
配方与经济管理/统一配方表/魔酿师饮品分类表.csv

# KubeJS 玩家背包导出（含玩家物品数据，不入库）
Server/kubejs/inventory_exports/*.json

# FUSE temp files (open handle leftovers)
.fuse_hidden*

# 本地服务器配置（不跟踪）：端口/性能为本地环境专属，远端用其他值
Server/server.properties
Server/config/c2me.toml

# LuckPerms 运行时权限数据
Server/config/luckperms/
# fuji 运行时缓存
Server/config/fuji/cache/
# fuji 语言默认文件(仅保留中文覆盖)
Server/config/fuji/languages/*
