# Line endings
*.sh text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.csv text eol=lf
*.bat text eol=crlf

# Binary files (do not touch line endings)
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.lzma binary
*.docx binary
*.ttf binary
*.otf binary
*.ogg binary
*.mcmeta binary
